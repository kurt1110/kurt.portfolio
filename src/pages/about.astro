---
import Layout from '../layouts/Layout.astro';
import Skills from '../components/Skills.astro';
---
<Layout title="About | Kurt Andrei C. Arata" description="Learn more about Kurt Andrei C. Arata — Information Technology student and full-stack developer from Cabanatuan City, Nueva Ecija.">
	<section class="about-page" data-reveal>
		<p class="eyebrow">About me</p>
		<p class="about-page-lead">
			Information Technology student at Araullo University, based in Cabanatuan City, Nueva Ecija.
			I focus on full-stack development — building practical web systems with tools like React, Astro, TypeScript, Node.js, PHP, and SQL.
			My work includes client and school projects such as a live logistics platform, bus tracking tools, education dashboards, and game discovery apps.
			I’m always learning through real builds, and I’m currently available for freelance and project work.
		</p>	

		<ul class="about-facts">
			<li><span>Full name</span><strong>Kurt Andrei C. Arata</strong></li>
			<li><span>Age</span><strong>21</strong></li>
			<li><span>Location</span><strong>Cabanatuan City, Nueva Ecija</strong></li>
			<li><span>Education</span><strong>Araullo University — Information Technology</strong></li>
		</ul>
	</section>
	<Skills />
</Layout>

<style>
	.about-page {
		max-width: 1120px;
		margin: 0 auto;
		padding: 5rem 2rem 2rem;
	}

	.about-page .eyebrow {
		margin: 0 0 1rem;
	}

	.about-page-lead {
		max-width: 42rem;
		margin: 0;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.75;
	}

	.about-facts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: .85rem;
		max-width: 52rem;
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.about-facts li {
		display: grid;
		gap: .35rem;
		padding: 1.1rem 1.15rem;
		border: 1px solid var(--header-border);
		border-radius: .9rem;
		background: var(--surface-soft);
	}

	.about-facts span {
		color: var(--accent);
		font-family: 'Courier New', monospace;
		font-size: .72rem;
		letter-spacing: .08em;
		text-transform: uppercase;
	}

	.about-facts strong {
		color: var(--heading);
		font-size: 1rem;
		font-weight: 700;
	}

	@media (max-width: 760px) {
		.about-page {
			padding: 3rem 1.1rem 1rem;
		}

		.about-page-lead {
			font-size: .95rem;
			line-height: 1.7;
		}

		.about-facts {
			grid-template-columns: 1fr;
			gap: .7rem;
			margin-top: 2rem;
		}

		.about-facts li {
			padding: 1rem 1.05rem;
		}

		.about-facts strong {
			overflow-wrap: anywhere;
			font-size: .95rem;
		}
	}

	@media (max-width: 420px) {
		.about-page {
			padding-left: .9rem;
			padding-right: .9rem;
		}
	}
</style>
