---
interface Props {
	href: string;
	secondary?: boolean;
	resume?: boolean;
	download?: string | boolean;
}

const { href, secondary = false, resume = false, download } = Astro.props;
const showExternalArrow = !secondary && !resume && !download;
---

<a
	href={href}
	class:list={['button', { secondary, resume }]}
	download={download === true ? '' : download || undefined}
>
	{resume && (
		<svg class="button-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
			<polyline points="7 10 12 15 17 10"></polyline>
			<line x1="12" y1="15" x2="12" y2="3"></line>
		</svg>
	)}
	<slot />
	{showExternalArrow && <span aria-hidden="true">↗</span>}
</a>
