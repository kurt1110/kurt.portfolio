---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
	featuredOnly?: boolean;
	liveOnly?: boolean;
	showViewAll?: boolean;
	eyebrow?: string;
	heading?: string;
	intro?: string;
}

const {
	featuredOnly = false,
	liveOnly = false,
	showViewAll = true,
	eyebrow = 'My ventures',
	heading = 'Powering web innovation<br />&amp; infrastructure',
	intro = 'Selected work built with care, clarity, and a focus on useful outcomes.',
} = Astro.props;

const visibleProjects = projects.filter((project) => {
	if (liveOnly && project.status !== 'live') return false;
	if (featuredOnly && !project.featured) return false;
	return true;
});
---
<section id="projects" class="projects-section" data-reveal>
	<div class="section-heading">
		<div>
			<p class="eyebrow">{eyebrow}</p>
			<h2 set:html={heading} />
			<p>{intro}</p>
		</div>
		{showViewAll && <a href="/projects">View all projects ↗</a>}
	</div>
	<div class="projects-list">
		{visibleProjects.map((project, index) => (
			<ProjectCard project={project} index={index} />
		))}
	</div>
</section>
