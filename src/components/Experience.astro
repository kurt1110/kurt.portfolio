---
import { experience } from '../data/experience';
---
<section class="section-rule mx-auto grid max-w-7xl gap-12 px-5 py-24 sm:px-8 lg:grid-cols-[0.8fr_1.2fr] lg:px-12 lg:py-32" data-reveal>
	<p class="eyebrow text-[var(--accent)]">Experience</p>
	<div>{experience.map((item) => <article class="grid gap-3 border-t border-[var(--line)] py-6 sm:grid-cols-[1fr_0.8fr]"><div><h3 class="font-semibold">{item.role}</h3><p class="mt-1 text-[var(--muted)]">{item.company}</p></div><div><p class="font-mono text-xs text-[var(--muted)]">{item.period}</p><p class="mt-3 text-sm leading-6 text-[var(--muted)]">{item.description}</p></div></article>)}</div>
</section>
