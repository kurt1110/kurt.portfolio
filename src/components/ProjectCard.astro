---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

const { project, index } = Astro.props as { project: Project; index: number };
const isExternal = Boolean(project.link && /^https?:\/\//.test(project.link));
const isLive = project.status === 'live' || (!project.status && isExternal);
const isOffline = project.status === 'offline';
---
<article class:list={['project-card', { 'project-card-reverse': index % 2 === 1 }]} data-project-item>
	<div class="project-copy">
		<div class="project-meta">
			<span>{project.category}</span>
			<span class="project-index">0{index + 1}</span>
		</div>
		<h3>{project.title}</h3>
		<p>{project.description}</p>
		<ul>
			{project.technologies.map((technology) => <li>{technology}</li>)}
		</ul>
		<div class="project-actions">
			{isLive && project.link && project.link !== '#' && (
				<a
					href={project.link}
					class="project-link"
					target={isExternal ? '_blank' : undefined}
					rel={isExternal ? 'noopener noreferrer' : undefined}
				>
					Visit live site <span aria-hidden="true">↗</span>
				</a>
			)}
			{isOffline && <span class="project-status-note">Offline project</span>}
		</div>
	</div>

	<div class:list={['project-visual', { 'project-visual-photo': Boolean(project.image) }]}>
		{project.image ? (
			<div class="project-frame">
				<div class="project-frame-bar" aria-hidden="true">
					<span></span><span></span><span></span>
					<em>{project.title}</em>
				</div>
				<div class="project-frame-screen">
					<Image
						src={project.image}
						alt={`${project.title} preview`}
						widths={[640, 960, 1280]}
						sizes="(max-width: 900px) 100vw, 560px"
						class="project-photo"
						loading="lazy"
					/>
				</div>
				{isLive && <p class="project-live-badge">Live</p>}
				{isOffline && <p class="project-offline-badge">Offline</p>}
			</div>
		) : (
			<>
				<span>{project.title}</span>
				<div class="visual-grid"></div>
			</>
		)}
	</div>
</article>

<style is:global>
	.project-frame-screen {
		display: block !important;
		width: 100%;
		line-height: 0;
		overflow: hidden;
		background: #0a0c14;
	}

	.project-frame-screen img,
	.project-frame-screen .project-photo,
	img.project-photo {
		display: block !important;
		width: 100% !important;
		max-width: 100% !important;
		height: auto !important;
		max-height: none !important;
		object-fit: contain !important;
		object-position: center top !important;
	}

	html[data-theme='light'] .project-frame-screen {
		background: #f4f6fb;
	}
</style>
